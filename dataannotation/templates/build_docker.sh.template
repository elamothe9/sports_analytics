#!/bin/bash
#
# Build Docker image for this task
#
# Usage: ./build_docker.sh
#

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
TASK_NAME="$(basename "$SCRIPT_DIR")"
IMAGE_NAME="sweagent-task-${TASK_NAME}"
TEMP_CONTEXT=""

cleanup() {
    if [ -n "$TEMP_CONTEXT" ] && [ -d "$TEMP_CONTEXT" ]; then
        rm -rf "$TEMP_CONTEXT"
    fi
}
trap cleanup EXIT

reject_local_context_instructions() {
    local dockerfile="$1"
    local line_num=0
    shopt -s nocasematch
    while IFS= read -r line; do
        line_num=$((line_num + 1))
        [[ -z "$line" || "$line" =~ ^[[:space:]]*# ]] && continue
        if [[ "$line" =~ ^[[:space:]]*(COPY|ADD)([[:space:]]|$) ]]; then
            [[ "$line" =~ --from= ]] && continue
            [[ "$line" =~ ^[[:space:]]*ADD([[:space:]]+--[^[:space:]]+)*[[:space:]]+https?:// ]] && continue
            echo "Error: Dockerfile depends on local build-context files (line $line_num):" >&2
            echo "  $line" >&2
            echo "Fetch the repo inside the image and pin extra dependencies inline." >&2
            exit 2
        fi
    done < "$dockerfile"
    shopt -u nocasematch
}

echo "Building Docker image: $IMAGE_NAME"
echo ""

reject_local_context_instructions "$SCRIPT_DIR/Dockerfile"

TEMP_CONTEXT="$(mktemp -d)"
cp "$SCRIPT_DIR/Dockerfile" "$TEMP_CONTEXT/Dockerfile"
if [ -f "$SCRIPT_DIR/.dockerignore" ]; then
    cp "$SCRIPT_DIR/.dockerignore" "$TEMP_CONTEXT/.dockerignore"
fi

docker build -t "$IMAGE_NAME" "$TEMP_CONTEXT"

echo ""
echo "Build complete: $IMAGE_NAME"
echo ""
echo "To test: ./run_docker.sh"
