#!/bin/bash
#
# Run Docker container for this task (interactive shell)
#
# Usage: ./run_docker.sh
#

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
TASK_NAME="$(basename "$SCRIPT_DIR")"
IMAGE_NAME="sweagent-task-${TASK_NAME}"
DOCKER_RUN_ARGS=()

if [ -n "${ETALON_DOCKER_RUN_ARGS:-}" ]; then
    read -r -a DOCKER_RUN_ARGS <<< "$ETALON_DOCKER_RUN_ARGS"
fi

echo "Starting container: $IMAGE_NAME"
echo "You'll get a bash shell inside the container at /app"
echo "Type 'exit' to leave."
if [ "${#DOCKER_RUN_ARGS[@]}" -gt 0 ]; then
    echo "Docker run args: ${DOCKER_RUN_ARGS[*]}"
fi
echo ""

docker run -it --rm "${DOCKER_RUN_ARGS[@]}" "$IMAGE_NAME"
